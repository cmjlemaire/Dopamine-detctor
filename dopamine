  function sparkline(data, w=160, h=32){
    const p=4; const max=Math.max(10, ...data); const min=0; const dx=(w-2*p)/(data.length-1); const sy=v=> h-p-(h-2*p)*((v-min)/(max-min||1));
    let path=''; data.forEach((v,i)=>{ const x=p+i*dx, y=sy(v); path+=(i?' L ':'M ')+x+' '+y; });
    return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}"><path d="${path}" fill="none" stroke="var(--accent)" stroke-width="2" /></svg>`;
  }

