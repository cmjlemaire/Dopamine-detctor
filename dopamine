  // ===== Top helpers (tour & help) ============================================
  $('#btn-tour').onclick = () => openOnboarding();
  $('#btn-help').onclick = () => alert('Parcours recommandé:
1) Onglet Profil → calcule ton segment.
2) Onglet Routine → choisis 2–3 piliers.
3) Onglet Detox → définis une habitude à réduire.
4) Onglet Journal → enregistre tes activités.
5) Onglet Données → note ta journée & exporte.');

  // ===== Init & render orchestrator ===========================================
  function render(){
    renderDashboard();
    if(!$('#journal').hidden) renderJournal();
    if(!$('#routine').hidden) renderRoutine();
    if(!$('#detox').hidden) renderDetox();
    if(!$('#profil').hidden) renderProfile();
    if(!$('#data').hidden) renderMetricsTrends();
    renderNavBadges();
  }

  ensureDay(todayKey());
  if(!localStorage.getItem('onboarding_complete')) openOnboarding();

  // wire minor
  $('#journal-date')?.addEventListener('change', drawEntries);

  // initial render
  render();
  </script>
</body>
</html>
