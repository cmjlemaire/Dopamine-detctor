  function radialGauge(value, min=0, max=400){
    const pct = Math.max(0, Math.min(1, (value-min)/(max-min)));
    const R = 90, cx=100, cy=100;
    const a = Math.PI * (1 - pct);
    const x = cx + R * Math.cos(a), y = cy + R * Math.sin(a);
    const large = pct>0.5 ? 1 : 0;
    const arc = `M ${cx-R},${cy} A ${R},${R} 0 ${large} 1 ${x},${y}`;
    return `<svg width="220" height="130" viewBox="0 0 200 120" role="img" aria-label="Jauge ${Math.round(pct*100)}%">
      <path d="M 10 100 A 90 90 0 1 1 190 100" fill="none" stroke="var(--border)" stroke-width="14" />
      <path d="${arc}" fill="none" stroke="var(--accent)" stroke-width="14" stroke-linecap="round" />
      <circle cx="${x}" cy="${y}" r="5" fill="var(--accent)" />
      <text x="100" y="105" text-anchor="middle" font-size="16" fill="var(--fg)" font-weight="700">${value} pts</text>
    </svg>`;
  }

  function trend30d(){
    const days=30, data=[]; const today=new Date();
    for(let i=days-1;i>=0;i--){ const d=new Date(today); d.setDate(today.getDate()-i); const k=d.toLocaleDateString('sv-SE'); const s=dailySummary(k); data.push({ d, k, v:s.total }); }
    const w=700,h=160,p=24, max=Math.max(100, ...data.map(d=>d.v));
    const dx=(w-2*p)/(days-1); const scaleY=v=> h-p - (h-2*p)*(v/max);
    let path=""; data.forEach((pt,i)=>{ const x=p+i*dx, y=scaleY(pt.v); path += (i?" L ":"M ")+x+" "+y; });
    const ticks = [0, Math.round(max/2), max];
    const grid = ticks.map(t=>`<line x1="${p}" x2="${w-p}" y1="${scaleY(t)}" y2="${scaleY(t)}" stroke="var(--border)" />`).join('');
    return `<svg width="100%" height="${h}" viewBox="0 0 ${w} ${h}">
      ${grid}
      <path d="${path}" fill="none" stroke="var(--accent)" stroke-width="2" />
      ${data.map((pt,i)=>`<circle cx="${p+i*dx}" cy="${scaleY(pt.v)}" r="2" fill="var(--accent)" />`).join('')}
    </svg>`;
  }

