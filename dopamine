<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>DopaTrack – Bien-être & Dopamine (HTML)</title>
  <meta name="description" content="Suivi dopamine immédiate vs durable, routine personnalisée, detox et métriques bien-être – application HTML standalone (localStorage)." />
  <style>
    /* ─────────────────────────────────────────────────────────────────
       DopaTrack – Single‑file HTML App (no backend)
       Design: clair, guidé, inspiré Apple (grande respiration, typographie nette)
       ----------------------------------------------------------------
    */
    :root { --bg:#f6f7fb; --fg:#0b0c10; --muted:#667085; --card:#ffffff; --elev:#fbfbfe; --border:#e6e8ee; --accent:#0b0c10; --good:#16a34a; --bad:#dc2626; --shadow: 0 10px 20px rgba(0,0,0,.05), 0 1px 2px rgba(0,0,0,.04); }
    @media (prefers-color-scheme: dark){
      :root { --bg:#0b0c10; --fg:#E5E7EB; --muted:#98a2b3; --card:#0f1116; --elev:#0c0e13; --border:#1e293b; --accent:#E5E7EB; --shadow: 0 12px 24px rgba(0,0,0,.35); }
    }
    html, body { height:100%; }
    body { margin:0; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, Segoe UI, Roboto, Ubuntu, Cantarell, "Helvetica Neue", Arial; background:var(--bg); color:var(--fg); }
    .container { max-width: 1100px; margin: 0 auto; padding: 20px; }

    /* Top hero */
    .hero { background: linear-gradient(180deg, rgba(0,0,0,.04), transparent); border-radius: 24px; padding: 18px 16px; border:1px solid var(--border); box-shadow: var(--shadow); }
    .brand { display:flex; align-items:center; gap:10px }
    .logo { width:28px; height:28px; border-radius:8px; background:radial-gradient(circle at 30% 30%, #8b5cf6, #06b6d4); }
    .title-xl { font-size: 22px; font-weight: 700; margin: 0 }
    .sub { color:var(--muted); font-size:13px }

    /* Tabs */
    .tabs { display:flex; gap:8px; flex-wrap:wrap; }
    .tab { padding:10px 14px; border:1px solid var(--border); background:var(--card); border-radius:14px; cursor:pointer; font-weight:600; box-shadow: var(--shadow); display:flex; align-items:center; gap:8px }
    .tab[aria-selected="true"]{ outline:2px solid #000; outline-color: color-mix(in oklab, var(--accent) 60%, transparent); }
    .badge { font-size:11px; padding:2px 6px; border-radius:999px; border:1px solid var(--border); background:var(--elev); }

    .grid { display:grid; gap:16px; }
    @media(min-width: 900px){ .grid-2{ grid-template-columns: 1.25fr 1fr } .grid-3{ grid-template-columns: repeat(3,1fr) } }
    .card { background:var(--card); border:1px solid var(--border); border-radius:20px; padding:16px; box-shadow: var(--shadow); }
    .title { font-size: 18px; font-weight: 700; margin: 4px 0 12px; }
    .muted { color: var(--muted); font-size: 13px; }
    .row { display:flex; gap:10px; align-items:center; flex-wrap:wrap }
    .btn { padding:10px 12px; border-radius:12px; border:1px solid var(--border); background:var(--card); cursor:pointer; box-shadow: var(--shadow); }
    .btn.primary { background:var(--accent); color: #fff; border-color: var(--accent); }
    .btn.ghost { background:transparent; box-shadow:none }
    .input, select, textarea { width:100%; padding:10px 12px; border-radius:12px; border:1px solid var(--border); background:var(--card); color:var(--fg) }
    label { font-size: 12px; color: var(--muted); display:block; margin-bottom:4px }
    .kpi { display:flex; flex-direction:column; gap:4px; }
    .kpi .v { font-size: 26px; font-weight: 700 }
    .pill { padding:4px 8px; border-radius:999px; border:1px solid var(--border); font-size:12px }
    .pill.good{ color:var(--good); border-color: var(--good) }
    .pill.bad{ color:var(--bad); border-color: var(--bad) }
    .list { display:flex; flex-direction:column; gap:8px }
    .divider { height:1px; background:var(--border); margin:8px 0 }
    details > summary { cursor:pointer; user-select:none; font-weight:600 }
    .footnote { font-size:12px; color: var(--muted) }
    .danger { color: var(--bad) }
    .success { color: var(--good) }

    /* Coach bar */
    .coach { position: sticky; bottom: 12px; z-index: 10; display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 12px; border:1px solid var(--border); background:var(--card); border-radius:14px; box-shadow: var(--shadow); }

    /* Empty states */
    .empty { border:1px dashed var(--border); background:var(--elev); padding:16px; border-radius:16px; font-size:13px; }
  </style>
</head>
<body>
  <div class="container">
    <header class="hero" role="banner" aria-label="En-tête">
      <div class="row" style="justify-content:space-between">
        <div class="brand">
          <div class="logo" aria-hidden="true"></div>
          <div>
            <h1 class="title-xl">DopaTrack</h1>
            <div class="sub">Comprends, mesure et équilibre ta dopamine – immédiate vs durable.</div>
          </div>
        </div>
        <div class="row">
          <button class="btn" id="btn-tour">🧭 Guide</button>
          <button class="btn" id="btn-help">❓ Aide</button>
        </div>
      </div>
      <nav class="tabs" id="tabs" role="tablist" style="margin-top:12px">
        <button class="tab" role="tab" aria-selected="true" data-tab="dashboard">🏠 Tableau <span class="badge" id="b-total">0</span></button>
        <button class="tab" role="tab" data-tab="journal">📝 Journal</button>
        <button class="tab" role="tab" data-tab="routine">🧱 Routine <span class="badge" id="b-routine">0/0</span></button>
        <button class="tab" role="tab" data-tab="detox">🧹 Detox <span class="badge" id="b-detox">—</span></button>
        <button class="tab" role="tab" data-tab="profil">🧠 Profil</button>
        <button class="tab" role="tab" data-tab="data">📦 Données</button>
      </nav>
    </header>

    <section class="footnote card" style="margin-top:12px" aria-live="polite">
      <strong>Important :</strong> application d’auto‑suivi éducative. Ne remplace pas un avis médical.
    </section>

    <!-- DASHBOARD -->
    <main id="dashboard" class="grid grid-2" role="region" aria-labelledby="tab-dashboard">
      <section class="card">
        <div class="title">Jauge dopamine (aujourd’hui)</div>
        <div class="muted">Objectif : viser ~2/3 durable – 1/3 immédiate. Ajoute au moins une activité durable.</div>
        <div class="row" style="justify-content:space-between; align-items:flex-start; margin-top:8px">
          <div id="gauge"></div>
          <div style="min-width:260px">
            <div class="kpi"><span class="muted">Total</span><span class="v" id="kpi-total">0</span></div>
            <div class="row" style="margin-top:8px">
              <span class="pill good">Durable: <b id="kpi-durable">0</b></span>
              <span class="pill bad">Imméd.: <b id="kpi-immediate">0</b></span>
            </div>
            <div class="divider"></div>
            <div class="muted" id="advice"></div>
          </div>
        </div>
      </section>
      <section class="card">
        <div class="title">Tendance 30 jours</div>
        <div class="muted">Visualise la charge globale de dopamine au fil du temps.</div>
        <div id="trend" aria-label="Graphique des 30 derniers jours" style="margin-top:8px"></div>
      </section>
      <section class="card">
        <div class="title">Actions rapides</div>
        <div class="row">
          <button class="btn primary" data-open="add-activity">+ Ajouter une activité</button>
          <button class="btn" data-open="rate-metrics">⭐ Noter ma journée</button>
          <button class="btn" data-open="quick-detox">🎯 Objectif detox</button>
        </div>
        <div id="empty-dashboard" class="empty" style="margin-top:10px" hidden>
          C’est vide. Commence par <b>ajouter une activité</b> (durable de préférence) ou <b>fixer un objectif detox</b>.
        </div>
      </section>

      <section class="coach" id="coach" aria-live="polite"></section>
    </main>

    <!-- JOURNAL -->
    <main id="journal" class="card" hidden>
      <div class="title">Journal d’activités</div>
      <div class="muted">Que faire ici ? Choisis une activité, indique quantité et durée, puis « Ajouter ».</div>
      <div class="row" style="justify-content:space-between; margin-top:8px">
        <input id="journal-date" type="date" class="input" style="width:auto" />
        <div class="row">
          <button class="btn" id="open-add">+ Ajouter</button>
          <button class="btn" id="quick-durable">🌿 Ajouter 20 min de lecture</button>
        </div>
      </div>
      <div class="row" style="margin:8px 0">
        <select id="tpl-select" style="min-width:260px"></select>
        <input id="qty" type="number" min="1" class="input" style="width:120px" placeholder="Quantité" />
        <input id="duration" type="number" min="1" class="input" style="width:160px" placeholder="Durée (min)" />
        <button class="btn primary" id="add-entry">Ajouter</button>
      </div>
      <div id="entries" class="list" aria-live="polite"></div>
      <div id="empty-journal" class="empty" hidden>Aucune entrée ce jour. Essaie : <button class="btn" data-open="add-activity">Ajouter une activité</button></div>
    </main>

    <!-- ROUTINE -->
    <main id="routine" class="grid grid-2" hidden>
      <section class="card">
        <div class="title">Routine fondatrice (max 3)</div>
        <div class="muted">Choisis 2–3 piliers durables (ex : sport, méditation, lecture). Option : ajouter automatiquement des points.</div>
        <div id="routine-builder" style="margin-top:8px"></div>
      </section>
      <section class="card">
        <div class="title">Ma routine aujourd’hui</div>
        <div class="row" style="justify-content:space-between">
          <div class="muted">Coche quand c’est fait. <label style="display:inline-block;margin-left:8px"><input id="auto-award" type="checkbox" /> Ajouter des points auto</label></div>
          <div id="routine-progress" class="pill"></div>
        </div>
        <div id="routine-today" class="list" style="margin-top:8px"></div>
      </section>
    </main>

    <!-- DETOX -->
    <main id="detox" class="grid grid-2" hidden>
      <section class="card">
        <div class="title">Plan detox</div>
        <div class="muted">Sélectionne une habitude immédiate à réduire progressivement.</div>
        <div class="row" style="margin:8px 0">
          <select id="detox-activity" style="min-width:260px"></select>
          <input id="detox-baseline" type="number" min="0" class="input" style="width:140px" placeholder="Baseline/j" />
          <input id="detox-target" type="number" min="0" class="input" style="width:140px" placeholder="Cible/j" />
          <button class="btn primary" id="save-detox">Enregistrer</button>
        </div>
        <div class="footnote">Ex : réseaux sociaux de 8 → 3 sessions/j, puis 2.</div>
      </section>
      <section class="card">
        <div class="title">Suivi detox</div>
        <div class="row">
          <button class="btn" id="detox-mark">+1 session évitée</button>
          <div id="detox-stats" class="pill"></div>
        </div>
        <div class="divider"></div>
        <ul id="detox-tips" class="list"></ul>
      </section>
    </main>

    <!-- PROFIL -->
    <main id="profil" class="grid grid-2" hidden>
      <section class="card">
        <div class="title">Évaluer mon profil dopamine</div>
        <form id="profile-form" class="list">
          <div>
            <label>Impulsivité numérique (scroll, notifications)</label>
            <input type="range" min="0" max="4" value="2" name="q1" />
          </div>
          <div>
            <label>Récompense rapide (sucre, achat impulsif)</label>
            <input type="range" min="0" max="4" value="2" name="q2" />
          </div>
          <div>
            <label>Énergie soutenue sans stimulants</label>
            <input type="range" min="0" max="4" value="2" name="q3" />
          </div>
          <div>
            <label>Capacité à rester en concentration profonde (30+ min)</label>
            <input type="range" min="0" max="4" value="2" name="q4" />
          </div>
          <div>
            <label>Qualité du sommeil (réveil naturel)</label>
            <input type="range" min="0" max="4" value="2" name="q5" />
          </div>
          <button class="btn primary" type="submit">Calculer mon profil</button>
        </form>
      </section>
      <section class="card">
        <div class="title">Résultat & recommandations</div>
        <div id="profile-result" class="list"></div>
      </section>
    </main>

    <!-- DATA -->
    <main id="data" class="grid grid-2" hidden>
      <section class="card">
        <div class="title">Export / Import</div>
        <div class="row">
          <button class="btn" id="export">Exporter JSON</button>
          <label class="btn" for="import">Importer JSON</label>
          <input id="import" type="file" accept="application/json" hidden />
          <button class="btn danger" id="reset">Réinitialiser</button>
        </div>
        <div class="footnote">Tes données restent sur cet appareil (localStorage). Tu peux relancer le guide d’accueil à tout moment.</div>
        <div class="row" style="margin-top:8px">
          <button class="btn" id="restart-onboarding">Relancer le guide d’accueil</button>
        </div>
      </section>
      <section class="card">
        <div class="title">Noter ma journée (métriques)</div>
        <form id="metrics-form" class="list">
          <div class="grid grid-3">
            <div><label>Humeur</label><input type="range" min="0" max="10" value="5" name="mood" /></div>
            <div><label>Énergie</label><input type="range" min="0" max="10" value="5" name="energy" /></div>
            <div><label>Concentration</label><input type="range" min="0" max="10" value="5" name="focus" /></div>
            <div><label>Sommeil</label><input type="range" min="0" max="10" value="5" name="sleep" /></div>
            <div><label>Confiance</label><input type="range" min="0" max="10" value="5" name="confidence" /></div>
          </div>
          <button class="btn primary" type="submit">Enregistrer</button>
        </form>
        <div id="metrics-trends" style="margin-top:8px"></div>
      </section>
    </main>
  </div>

  <!-- Entry template -->
  <template id="entry-row">
    <div class="card" data-id="">
      <div class="row" style="justify-content:space-between">
        <div class="row">
          <div class="pill" data-type="">Type</div>
          <div style="font-weight:600;margin-left:8px" data-name>Nom</div>
        </div>
        <div class="row">
          <span class="muted">Points:</span><b style="margin-left:6px" data-pts>0</b>
        </div>
      </div>
      <div class="row muted" style="justify-content:space-between; margin-top:6px">
        <div>Qté: <span data-qty>1</span> • Durée: <span data-dur>-</span></div>
        <div class="row">
          <button class="btn ghost" data-action="edit">Modifier</button>
          <button class="btn ghost danger" data-action="delete">Supprimer</button>
        </div>
      </div>
    </div>
  </template>

  <!-- Add activity dialog -->
  <dialog id="dlg-add" style="border:none;border-radius:16px;max-width:560px;width:100%">
    <form method="dialog" class="card">
      <div class="title">Ajouter une activité</div>
      <div class="row">
        <select id="dlg-tpl" style="min-width:260px"></select>
        <input id="dlg-qty" type="number" min="1" class="input" style="width:120px" placeholder="Quantité" />
        <input id="dlg-duration" type="number" min="1" class="input" style="width:160px" placeholder="Durée (min)" />
      </div>
      <div class="row" style="justify-content:flex-end;margin-top:8px">
        <button class="btn" value="cancel">Annuler</button>
        <button class="btn primary" value="ok">Ajouter</button>
      </div>
    </form>
  </dialog>

  <!-- Metrics dialog -->
  <dialog id="dlg-metrics" style="border:none;border-radius:16px;max-width:520px;width:100%">
    <form method="dialog" class="card">
      <div class="title">Noter ma journée</div>
      <div class="grid grid-3">
        <div><label>Humeur</label><input id="dm-mood" type="range" min="0" max="10" value="5"></div>
        <div><label>Énergie</label><input id="dm-energy" type="range" min="0" max="10" value="5"></div>
        <div><label>Concentration</label><input id="dm-focus" type="range" min="0" max="10" value="5"></div>
        <div><label>Sommeil</label><input id="dm-sleep" type="range" min="0" max="10" value="5"></div>
        <div><label>Confiance</label><input id="dm-confidence" type="range" min="0" max="10" value="5"></div>
      </div>
      <div class="row" style="justify-content:flex-end;margin-top:8px">
        <button class="btn" value="cancel">Fermer</button>
        <button class="btn primary" value="ok">Enregistrer</button>
      </div>
    </form>
  </dialog>

  <!-- Onboarding dialog (multi-étapes) -->
  <dialog id="dlg-onboard" style="border:none;border-radius:16px;max-width:720px;width:100%">
    <form method="dialog" class="card" id="onboard-form">
      <div class="title">Bienvenue sur DopaTrack</div>
      <div class="muted">Quelques questions pour personnaliser ton expérience. (~1 min)</div>
      <div class="divider"></div>
      <div id="ob-step"></div>
      <div class="row" style="justify-content:space-between; margin-top:8px">
        <button class="btn" value="back" id="ob-back">Retour</button>
        <div class="row">
          <button class="btn" value="cancel">Plus tard</button>
          <button class="btn primary" value="next" id="ob-next">Suivant</button>
        </div>
      </div>
    </form>
  </dialog>

  <script>
  // ===== Core data & helpers ==================================================
  const STORE_KEY = 'dopatrack_store_v2';
  const $ = (sel, el=document) => el.querySelector(sel);
  const $$ = (sel, el=document) => Array.from(el.querySelectorAll(sel));
  const todayKey = () => new Date().toLocaleDateString('sv-SE'); // YYYY-MM-DD

  const defaultStore = () => ({
    user: { name: '', goal: '' },
    entries: {},        // dateKey → Entry[]
    metrics: {},        // dateKey → Metric
    routine: { items: [], checks: {} },
    detox: null,        // { targetTemplateId, baselinePerDay, targetPerDay, startDate, avoidedCount }
    profile: null       // { segment, scores }
  });

  let store = loadStore();
  function loadStore(){
    try { return JSON.parse(localStorage.getItem(STORE_KEY)) || defaultStore(); }
    catch { return defaultStore(); }
  }
  function saveStore(){ localStorage.setItem(STORE_KEY, JSON.stringify(store)); }

  // Activity catalog (diversifié)
  const ACTIVITY_TEMPLATES = [
    // Immédiate (reward rapide)
    { id:'cig', name:'Cigarette', type:'immediate', basePoints:100, unit:'cig', defaultDuration:5 },
    { id:'sugar', name:'Nourriture sucrée', type:'immediate', basePoints:60, unit:'portion', defaultDuration:10 },
    { id:'social', name:'Réseaux sociaux (15 min)', type:'immediate', basePoints:50, unit:'session', defaultDuration:15 },
    { id:'energy', name:'Boisson énergétique', type:'immediate', basePoints:65, unit:'canette', defaultDuration:5 },
    { id:'alcohol', name:'Alcool (1 verre)', type:'immediate', basePoints:70, unit:'verre', defaultDuration:30 },
    { id:'gaming', name:'Jeux vidéo (30 min)', type:'immediate', basePoints:55, unit:'session', defaultDuration:30 },
    { id:'fastfood', name:'Fast‑food', type:'immediate', basePoints:75, unit:'repas', defaultDuration:20 },

    // Durable (fondatrice)
    { id:'sport', name:'Sport modéré (30 min)', type:'durable', basePoints:80, unit:'session', defaultDuration:30 },
    { id:'nature', name:'Prendre l’air / nature', type:'durable', basePoints:40, unit:'sortie', defaultDuration:20 },
    { id:'medit', name:'Méditation', type:'durable', basePoints:35, unit:'session', defaultDuration:10 },
    { id:'deep', name:'Deep work (60 min)', type:'durable', basePoints:70, unit:'session', defaultDuration:60 },
    { id:'read', name:'Lecture profonde (20 min)', type:'durable', basePoints:45, unit:'session', defaultDuration:20 },
    { id:'yoga', name:'Yoga/Respiration (15 min)', type:'durable', basePoints:40, unit:'session', defaultDuration:15 },
    { id:'music', name:'Musique active (jouer/chanter)', type:'durable', basePoints:35, unit:'session', defaultDuration:20 },
    { id:'cold', name:'Douche froide (2–3 min)', type:'durable', basePoints:30, unit:'session', defaultDuration:3 },
    { id:'sauna', name:'Sauna (10–15 min)', type:'durable', basePoints:35, unit:'session', defaultDuration:15 },
    { id:'protein', name:'Repas protéiné équilibré', type:'durable', basePoints:30, unit:'repas', defaultDuration:20 },
    { id:'fruit', name:'Fruits & eau (collation)', type:'durable', basePoints:20, unit:'collation', defaultDuration:5 },
    { id:'volunteer', name:'Service/Bénévolat', type:'durable', basePoints:50, unit:'action', defaultDuration:60 }
  ];
  const TPL_MAP = new Map(ACTIVITY_TEMPLATES.map(t => [t.id, t]));

  function computePoints(base, qty=1, durMin=null, defDur=null){
    const q = Math.max(0, Number(qty)||1);
    const m = (durMin && defDur) ? Math.max(0.25, durMin/defDur) : 1;
    return Math.round(base * q * m);
  }

  function ensureDay(dateKey){
    if(!store.entries[dateKey]) store.entries[dateKey] = [];
    if(!store.metrics[dateKey]) store.metrics[dateKey] = { mood:5, energy:5, focus:5, sleep:5, confidence:5 };
    if(!store.routine.checks[dateKey]) store.routine.checks[dateKey] = {};
  }

  // ===== UI state & navigation ===============================================
  const tabs = $('#tabs');
  tabs.addEventListener('click', (e)=>{
    const b = e.target.closest('[data-tab]'); if(!b) return;
    $$('.tab', tabs).forEach(t=>t.setAttribute('aria-selected', String(t===b)));
    const id = b.dataset.tab;
    $$('main').forEach(m=> m.hidden = m.id !== id);
    render();
  });

  // Quick actions
  document.body.addEventListener('click', (e)=>{
    const openBtn = e.target.closest('[data-open]'); if(openBtn){ handleOpen(openBtn.dataset.open); }
  });

  function handleOpen(key){
    if(key==='add-activity'){ openAddDialog(); }
    if(key==='rate-metrics'){ openMetricsDialog(); }
    if(key==='quick-detox'){ $$('[data-tab="detox"]')[0].click(); }
  }

  // ===== Dashboard ============================================================
  function dailySummary(dateKey){
    ensureDay(dateKey);
    const day = store.entries[dateKey];
    let total=0, immediate=0, durable=0;
    for(const e of day){
      const t = TPL_MAP.get(e.templateId);
      total += e.points;
      if(t?.type==='durable') durable += e.points; else immediate += e.points;
    }
    const ratio = total>0 ? durable/total : 0;
    const advice = recommend(total, durable, immediate, store.metrics[dateKey]);
    return { total, immediate, durable, ratio, advice };
  }

  function recommend(total, durable, immediate, metrics){
    if(total===0) return "Commence par 10 min de marche + 2 min de respiration.";
    const ratio = durable/(total||1);
    const tips = [];
    if(ratio<0.4) tips.push("Remplace une session immédiate par 20 min de lecture/méditation.");
    if(immediate>durable) tips.push("Limite écran (2×15 min) et planifie une sortie nature.");
    if(metrics.sleep<5) tips.push("Coupe les écrans 60 min avant le coucher.");
    if(metrics.energy<5) tips.push("Ajoute 30 min d’activité modérée.");
    if(metrics.focus<5) tips.push("Bloc de deep work 25–50 min sans notifications.");
